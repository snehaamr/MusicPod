{
  "uid": "musicpod-outbox",
  "title": "MusicPod - Transactional Outbox",
  "tags": ["musicpod", "outbox", "kafka"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pending Events",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "musicpod_outbox_pending",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Processing Events",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "musicpod_outbox_processing",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Dead Events",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "musicpod_outbox_dead",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Publish Throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(musicpod_outbox_publish_success_total[5m])",
          "legendFormat": "success/sec"
        },
        {
          "refId": "B",
          "expr": "rate(musicpod_outbox_publish_failure_total[5m])",
          "legendFormat": "failure/sec"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Publish Failure Rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (rate(musicpod_outbox_publish_failure_total[5m]) / clamp_min(rate(musicpod_outbox_publish_success_total[5m]) + rate(musicpod_outbox_publish_failure_total[5m]), 0.001))",
          "legendFormat": "failure %"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Publish Latency p95 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(musicpod_outbox_publish_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(musicpod_outbox_publish_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
